<?xml version="1.0" encoding="utf-8"?>
<openerp>
  <data>
    <record id="dossier_tree" model="ir.ui.view">
      <field name="name">dossier.tree</field>
      <field name="model">suivi.dossier</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="client_id"/>
          <field name="total"/>
          <field name="inexistant"/>
        </tree>
      </field>
    </record>
    <record id="dossier_form" model="ir.ui.view">
      <field name="name">dossier.form</field>
      <field name="model">suivi.dossier</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_valider" string="Valider" type="object"/>
          </header>
          <field name="name"/>
          <field name="montant" attrs="{'readonly': [('state', '=', 'valide')]}"/>
        </form>
      </field>
    </record>
    <record id="action_dossier" model="ir.actions.act_window">
      <field name="name">Dossiers</field>
      <field name="res_model">suivi.dossier</field>
      <field name="view_type">form</field>
      <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_dossier" name="Dossiers" action="action_dossier"/>
  </data>
</openerp>
