<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ansut_integration_view_tree" model="ir.ui.view">
        <field name="name">ansut.integration.tree</field>
        <field name="model">ansut.integration</field>
        <field name="arch" type="xml">
            <tree string="Intégrations" sample="1"
                  decoration-success="state == 'terminee'">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="date_prise_fonction"/>
                <field name="accompagnateur_id"/>
                <field name="progress_documents" widget="progressbar"/>
                <field name="progress_kit" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'en_cours'"
                       decoration-success="state == 'terminee'"/>
            </tree>
        </field>
    </record>

    <record id="ansut_integration_view_form" model="ir.ui.view">
        <field name="name">ansut.integration.form</field>
        <field name="model">ansut.integration</field>
        <field name="arch" type="xml">
            <form string="Dossier d'intégration">
                <header>
                    <button name="action_terminer" type="object"
                            string="Marquer terminée" class="btn-primary"
                            invisible="state == 'terminee'"/>
                    <button name="action_rouvrir" type="object"
                            string="Rouvrir" invisible="state == 'en_cours'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="employee_id"
                                   placeholder="Recrue…"
                                   options="{'no_create': False}"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="department_id"/>
                            <field name="date_prise_fonction"/>
                            <field name="accompagnateur_id"/>
                        </group>
                        <group>
                            <field name="progress_documents" widget="progressbar"/>
                            <field name="progress_kit" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pièces administratives" name="documents">
                            <field name="document_ids">
                                <tree editable="bottom">
                                    <field name="done"/>
                                    <field name="name"/>
                                    <field name="date_reception"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Kit d'intégration" name="kit">
                            <field name="kit_ids">
                                <tree editable="bottom">
                                    <field name="done"/>
                                    <field name="name"/>
                                    <field name="responsable"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"
                                   placeholder="Induction, présentation au personnel, remarques…"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="ansut_integration_view_search" model="ir.ui.view">
        <field name="name">ansut.integration.search</field>
        <field name="model">ansut.integration</field>
        <field name="arch" type="xml">
            <search string="Intégrations">
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter string="En cours" name="en_cours"
                        domain="[('state', '=', 'en_cours')]"/>
                <filter string="Terminées" name="terminees"
                        domain="[('state', '=', 'terminee')]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Direction" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Statut" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ansut_integration" model="ir.actions.act_window">
        <field name="name">Intégrations</field>
        <field name="res_model">ansut.integration</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_en_cours': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez un dossier d'intégration</p>
            <p>Chaque dossier suit la procédure ANSUT-RH-PR-004 : pièces
               administratives à fournir, kit d'intégration (DRHCom, DJMG, DSIS)
               et accompagnateur désigné.</p>
        </field>
    </record>

    <menuitem id="menu_ansut_integration" name="Intégrations (ANSUT)"
              parent="hr.menu_hr_root" action="action_ansut_integration"
              sequence="15" groups="hr.group_hr_user"/>

</odoo>
